# =============================================================================
# LifeLine Agent — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env
# =============================================================================

# ── Core AI & LLM Models ──────────────────────────────────────────────────────
# Required for live agent reasoning (Gemini 3.1 Pro & Gemini 3.5 Flash).
# Obtain key at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# ── Server & Runtime Configuration ────────────────────────────────────────────
# Bind host and port for FastAPI backend server
HOST=0.0.0.0
PORT=8000

# Default city for OpenStreetMap hospital queries (e.g. mumbai, delhi, london, seattle)
DEMO_CITY=mumbai

# Enables zero-friction evaluation mode with mock tokens (lifeline_mock_<role>_<uid>)
DEMO_AUTH_MODE=true

# Backend API base URL used by React / Next.js frontend clients
VITE_API_BASE_URL=http://localhost:8000

# ── Google Cloud & Firestore Database ────────────────────────────────────────
# Google Cloud Project ID hosting Firestore collections
FIRESTORE_PROJECT_ID=your-gcp-project-id
GCP_PROJECT_ID=your-gcp-project-id

# Firestore audit log collection name for dispatch execution traces
FIRESTORE_COLLECTION=dispatch_cases

# Path to Google Cloud Service Account JSON file (optional if running in Cloud Run / ADC)
GOOGLE_APPLICATION_CREDENTIALS=

# Raw Firebase Service Account JSON string (optional, used by encrypted config manager)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Firebase Web API Key for client-side / admin auth verification
FIREBASE_WEB_API_KEY=

# ── Security & Cryptography ───────────────────────────────────────────────────
# Fernet AES-256 encryption key for sensitive local configuration at rest
CONFIG_ENCRYPTION_KEY=
