GEMINI_API_KEY=your-gemini-api-key-here

# ─── GCP / Firebase Project ───────────────────────────────────────────────────
# These are non-secret project identifiers (safe in version control)
GCP_PROJECT_ID=lifeline-3725b
CLOUD_RUN_REGION=us-central1

# Firebase project metadata (NOT secret — visible in any deployed app)
FIREBASE_PROJECT_ID=lifeline-3725b
FIREBASE_AUTH_DOMAIN=lifeline-3725b.firebaseapp.com
FIREBASE_STORAGE_BUCKET=lifeline-3725b.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=413566367910
FIREBASE_APP_ID=1:413566367910:web:602159713b9c7f2b5cdc67
FIREBASE_MEASUREMENT_ID=G-4WFE47EYLS

# ─── Firebase Secrets — store via `lifeline admin`, NOT here ──────────────────
# FIREBASE_WEB_API_KEY           → run: lifeline admin  (stored AES-256 encrypted)
# FIREBASE_SERVICE_ACCOUNT_JSON  → run: lifeline admin  (stored AES-256 encrypted)
#
# For local dev fallback only (never commit the real file path with key inside):
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json

# ─── App Config ───────────────────────────────────────────────────────────────
FIRESTORE_COLLECTION=dispatch_cases
DEMO_CITY=mumbai

# ─── NOTE ─────────────────────────────────────────────────────────────────────
# API keys and service account JSON are NEVER stored in this file.
