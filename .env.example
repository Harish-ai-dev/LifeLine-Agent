# ─── Gemini / Google AI ────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ─── GCP Project ──────────────────────────────────────────────────────────────
GCP_PROJECT_ID=lifeline-agent-demo
CLOUD_RUN_REGION=us-central1

# ─── Firebase ─────────────────────────────────────────────────────────────────
# Web API Key: Firebase Console → Project Settings → General → Web API Key
FIREBASE_WEB_API_KEY=your-firebase-web-api-key-here

# Path to service account JSON for local dev (Cloud Run uses default credentials)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json

# ─── App Config ───────────────────────────────────────────────────────────────
FIRESTORE_COLLECTION=dispatch_cases
DEMO_CITY=mumbai

# ─── NOTE ─────────────────────────────────────────────────────────────────────
# Do NOT set these directly in production.
# Use 'lifeline admin' to store keys encrypted, or use GCP Secret Manager.
# The FIREBASE_SERVICE_ACCOUNT_JSON is managed via 'lifeline admin' only — 
# never paste it into this file.
