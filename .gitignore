# ─── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/

# ─── Secrets — NEVER commit these ─────────────────────────────────────────────
.env
.env.local
.env.*.local
.admin_auth.json            # bcrypt admin credentials (legacy)
.admin_config.enc           # AES-encrypted API key store (machine-locked)
serviceAccountKey.json      # Firebase service account
*service_account*.json
*credentials*.json
*private_key*.json
*secret*.json
*.pem
*.key
*.p12
*.pfx

# ─── Secrets directory (catch-all safe folder for any local key files) ─────────
secrets/
.secrets/

# ─── Firebase / GCP ────────────────────────────────────────────────────────────
.firebase/
firebase-debug.log
.firebaserc
firebase-config.js          # Never commit JS SDK config with API key
firebase-config.ts

# ─── Node / JS (if a web frontend is added) ────────────────────────────────────
node_modules/
.npm/
*.lock                      # package-lock.json / yarn.lock have no secrets but keep clean

# ─── Data (generated, not source) ─────────────────────────────────────────────
data/hospitals_raw.json
data/hospitals.json

# ─── Test / Coverage ───────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# ─── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.iml

# ─── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Streamlit ─────────────────────────────────────────────────────────────────
.streamlit/secrets.toml

# ─── ADK Session Storage ───────────────────────────────────────────────────────
.adk/
lifeline_adk/.adk/

# ─── Local Runner Scripts ─────────────────────────────────────────────────────
*.bat
*.cmd
*.ps1
start.bat
